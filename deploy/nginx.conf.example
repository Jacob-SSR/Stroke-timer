# Adapt subnet, hostname, certificate paths and timeout to your hospital.
server {
    listen 443 ssl;
    server_name stroke.hospital.local;
    ssl_certificate     /etc/nginx/certs/hospital.crt;
    ssl_certificate_key /etc/nginx/certs/hospital.key;
    allow 127.0.0.1;
    allow 192.168.0.0/16;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    deny all;
    client_max_body_size 256k;
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
}
